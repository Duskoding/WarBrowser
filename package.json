{
  "name": "warbrowser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite gui",
    "build": "tsc -p gui/tsconfig.json && vite build gui",
    "pretest": "npm run build",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json && tsc -p gui/tsconfig.json",
    "migrate:users": "node scripts/migrate-users.mjs",
    "build:preview": "vite build --config gui/preview/vite.config.ts && node gui/preview/make.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.11"
  }
}
